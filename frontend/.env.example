# Backend API origin (public base URL only — never secrets).
# Local dev: leave empty so relative /api paths use the Vite proxy (→ http://localhost:8000).
# Vercel services (same-domain /api rewrites): leave empty — the browser calls
# the same origin and Vercel routes /api/* to the backend service.
# Split deploy (frontend on Vercel, backend on Render): set to the deployed
# Render backend URL, e.g. VITE_API_URL=https://<service>.onrender.com
VITE_API_URL=

# Demo auth credentials for local UI testing (Vite exposes only VITE_* vars).
# Copy to .env.local for local development.

VITE_DEMO_GOVERNMENT_EMAIL=officer.demo@zameenai.gov.in
VITE_DEMO_GOVERNMENT_PASSWORD=Demo@123
VITE_DEMO_CITIZEN_EMAIL=citizen@test.com
VITE_DEMO_CITIZEN_PASSWORD=citizen

VITE_DEMO_SIGNUP_GOVERNMENT_EMAIL=anjali.sharma.demo@zameenai.gov.in
